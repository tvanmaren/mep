#!/usr/bin/env bash
set -uo pipefail

MEP_BIN_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
MEP_HOME=$(cd "$MEP_BIN_DIR/.." && pwd)

# shellcheck source=../lib/json.sh
. "$MEP_HOME/lib/json.sh"
# shellcheck source=../lib/registry.sh
. "$MEP_HOME/lib/registry.sh"
# shellcheck source=../lib/deps.sh
. "$MEP_HOME/lib/deps.sh"
# shellcheck source=../lib/config.sh
. "$MEP_HOME/lib/config.sh"
# shellcheck source=../lib/paths.sh
. "$MEP_HOME/lib/paths.sh"
# shellcheck source=../lib/profile.sh
. "$MEP_HOME/lib/profile.sh"
# shellcheck source=../lib/events.sh
. "$MEP_HOME/lib/events.sh"
# shellcheck source=../lib/manifest.sh
. "$MEP_HOME/lib/manifest.sh"
# shellcheck source=../lib/finish.sh
. "$MEP_HOME/lib/finish.sh"
# shellcheck source=../lib/mark.sh
. "$MEP_HOME/lib/mark.sh"
# shellcheck source=../lib/status.sh
. "$MEP_HOME/lib/status.sh"
# shellcheck source=../lib/checks.sh
. "$MEP_HOME/lib/checks.sh"
# shellcheck source=../lib/doctor.sh
. "$MEP_HOME/lib/doctor.sh"
# shellcheck source=../lib/document.sh
. "$MEP_HOME/lib/document.sh"
# shellcheck source=../lib/resolver.sh
. "$MEP_HOME/lib/resolver.sh"
# shellcheck source=../lib/pr.sh
. "$MEP_HOME/lib/pr.sh"
# shellcheck source=../lib/checkpoint.sh
. "$MEP_HOME/lib/checkpoint.sh"
# shellcheck source=../lib/lifecycle.sh
. "$MEP_HOME/lib/lifecycle.sh"
# shellcheck source=../lib/curate.sh
. "$MEP_HOME/lib/curate.sh"
# shellcheck source=../lib/exec.sh
. "$MEP_HOME/lib/exec.sh"
# shellcheck source=../lib/workflow.sh
. "$MEP_HOME/lib/workflow.sh"
# shellcheck source=../lib/migrate.sh
. "$MEP_HOME/lib/migrate.sh"

mep_usage() {
  mep_usage_from_registry
  mep_exit_for_status usage
}

mep_load_runtime() {
  local root
  root=$(mep_repo_root)
  mep_load_config "$root"
  case "$MEP_VCS_KIND" in
    git)
      # shellcheck source=../lib/vcs/git.sh
      . "$MEP_HOME/lib/vcs/git.sh"
      ;;
    *)
      printf '{"status":"missing_dependency","missing":[%s],"detail":' "$(mep_json_string "$MEP_VCS_KIND")"
      mep_json_string "unsupported vcs.kind '$MEP_VCS_KIND'"
      printf '}\n'
      mep_exit_for_status missing_dependency
      ;;
  esac
}

mep_expect_json_flag() {
  [[ "${1:-}" == "--json" ]] || mep_usage
}

mep_load_runtime
mep_require jq rg "$MEP_VCS_KIND" || mep_exit_for_status missing_dependency

case "${1:-}" in
  help)
    mep_help
    ;;
  version)
    mep_expect_json_flag "${2:-}"
    mep_dispatch_json mep_version_json
    ;;
  config)
    [[ "${2:-}" == "dump" ]] || mep_usage
    mep_expect_json_flag "${3:-}"
    mep_dispatch_json mep_config_dump_json
    ;;
  profile)
    [[ "${2:-}" == "dump" ]] || mep_usage
    mep_expect_json_flag "${3:-}"
    mep_dispatch_json mep_profile_dump_json
    ;;
  paths)
    slug=${2:-}
    [[ -n "$slug" ]] || mep_usage
    mep_expect_json_flag "${3:-}"
    mep_dispatch_json mep_paths_json "$slug"
    ;;
  status)
    slug=${2:-}
    [[ -n "$slug" ]] || mep_usage
    [[ "${3:-}" == "--compact" && "${4:-}" == "--json" ]] || mep_usage
    mep_dispatch_json mep_status_compact_json "$slug"
    ;;
  check)
    case "${2:-}" in
      scaffolding)
        shift 2
        args=()
        while (( $# )); do
          case "$1" in
            --json) ;;
            *) args+=("$1") ;;
          esac
          shift
        done
        mep_dispatch_json mep_check_scaffolding_json "${args[@]}"
        ;;
      prep-active)
        [[ "${3:-}" == "--json" ]] || mep_usage
        mep_dispatch_json mep_check_prep_active_json
        ;;
      *)
        mep_usage
        ;;
    esac
    ;;
  doctor)
    slug=${2:-}
    [[ -n "$slug" ]] || mep_usage
    shift 2
    json=0
    fix=0
    trunk=$MEP_VCS_DEFAULT_TRUNK
    while (( $# )); do
      case "$1" in
        --json) json=1 ;;
        --fix) fix=1 ;;
        --trunk)
          shift
          trunk=${1:-}
          [[ -n "$trunk" ]] || mep_usage
          ;;
        *) mep_usage ;;
      esac
      shift
    done
    (( json )) || mep_usage
    mep_dispatch_json mep_doctor_json "$slug" "$fix" "$trunk"
    ;;
  where)
    slug=${2:-}
    [[ -n "$slug" ]] || mep_usage
    mep_expect_json_flag "${3:-}"
    mep_dispatch_json mep_where_json "$slug"
    ;;
  exec)
    [[ "${2:-}" == "dispatch" ]] || mep_usage
    shift 2
    json=0
    dry_run=0
    executor=$MEP_EXECUTORS_DEFAULT
    request_json=
    while (( $# )); do
      case "$1" in
        --json) json=1 ;;
        --dry-run) dry_run=1 ;;
        --executor)
          shift
          executor=${1:-}
          [[ -n "$executor" ]] || mep_usage
          ;;
        --request-json)
          shift
          request_json=${1:-}
          [[ -n "$request_json" ]] || mep_usage
          ;;
        *) mep_usage ;;
      esac
      shift
    done
    (( json )) || mep_usage
    if [[ -z "$request_json" && ! -t 0 ]]; then
      request_json=$(cat)
    fi
    [[ -n "$request_json" ]] || mep_usage
    mep_dispatch_json mep_exec_dispatch_json "$request_json" "$executor" "$dry_run"
    ;;
  implement)
    [[ "${2:-}" == "--json" ]] || mep_usage
    brief_path=${3:-}
    [[ -n "$brief_path" && $# == 3 ]] || mep_usage
    mep_dispatch_json mep_implement_scope_json "$brief_path"
    ;;
  mode)
    [[ "${2:-}" == "set" ]] || mep_usage
    slug=${3:-}
    mode=${4:-}
    [[ -n "$slug" && -n "$mode" ]] || mep_usage
    mep_lifecycle_validate_mode "$mode" || mep_usage
    shift 4
    json=0
    dry_run=0
    while (( $# )); do
      case "$1" in
        --json) json=1 ;;
        --dry-run) dry_run=1 ;;
        *) mep_usage ;;
      esac
      shift
    done
    (( json )) || mep_usage
    mep_dispatch_json mep_mode_set_json "$slug" "$mode" "$dry_run"
    ;;
  migrate)
    slug=${2:-}
    [[ -n "$slug" && "$slug" != --* ]] || mep_usage
    shift 2
    json=0
    dry_run=0
    while (( $# )); do
      case "$1" in
        --json) json=1 ;;
        --dry-run) dry_run=1 ;;
        *) mep_usage ;;
      esac
      shift
    done
    (( json )) || mep_usage
    mep_dispatch_json mep_migrate_json "$slug" "$dry_run"
    ;;
  commit)
    [[ "${2:-}" == "scope" ]] || mep_usage
    slug=${3:-}
    [[ -n "$slug" ]] || mep_usage
    mep_expect_json_flag "${4:-}"
    [[ $# == 4 ]] || mep_usage
    mep_dispatch_json mep_commit_scope_json "$slug"
    ;;
  evidence)
    [[ "${2:-}" == "write" ]] || mep_usage
    slug=${3:-}
    evidence_kind=${4:-}
    evidence_state=${5:-}
    [[ -n "$slug" && -n "$evidence_kind" && -n "$evidence_state" ]] || mep_usage
    shift 5
    json=0
    dry_run=0
    detail=
    while (( $# )); do
      case "$1" in
        --json) json=1 ;;
        --dry-run) dry_run=1 ;;
        --detail)
          shift
          detail=${1:-}
          [[ -n "$detail" ]] || mep_usage
          ;;
        *) mep_usage ;;
      esac
      shift
    done
    (( json )) || mep_usage
    mep_dispatch_json mep_evidence_write_json "$slug" "$evidence_kind" "$evidence_state" "$detail" "$dry_run"
    ;;
  events)
    [[ "${2:-}" == "tail" ]] || mep_usage
    shift 2
    json=0
    slug_filter=
    event_filter=
    version_filter=
    limit=$MEP_EVENT_DEFAULT_TAIL_LIMIT
    while (( $# )); do
      case "$1" in
        --json) json=1 ;;
        --slug)
          shift
          slug_filter=${1:-}
          [[ -n "$slug_filter" ]] || mep_usage
          ;;
        --event)
          shift
          event_filter=${1:-}
          [[ -n "$event_filter" ]] || mep_usage
          ;;
        --version)
          shift
          version_filter=${1:-}
          [[ "$version_filter" =~ ^[0-9]+$ ]] || mep_usage
          ;;
        --limit)
          shift
          limit=${1:-}
          [[ "$limit" =~ ^[0-9]+$ ]] || mep_usage
          ;;
        *) mep_usage ;;
      esac
      shift
    done
    (( json )) || mep_usage
    mep_dispatch_json mep_events_tail_json "$limit" "$slug_filter" "$event_filter" "$version_filter"
    ;;
  pr)
    [[ "${2:-}" == "scaffold" ]] || mep_usage
    slug=${3:-}
    n=${4:-}
    [[ -n "$slug" && "$n" =~ ^[0-9]+$ ]] || mep_usage
    mep_expect_json_flag "${5:-}"
    mep_dispatch_json mep_pr_scaffold "$slug" "$n" "${5:-}"
    ;;
  finish)
    [[ "${2:-}" == "scan" ]] || mep_usage
    slug=${3:-}
    [[ -n "$slug" ]] || mep_usage
    mep_expect_json_flag "${4:-}"
    mep_dispatch_json mep_finish_scan_json "$slug"
    ;;
  mark)
    mark_kind=${2:-}
    mark_path=${3:-}
    [[ -n "$mark_kind" && -n "$mark_path" ]] || mep_usage
    shift 3
    json=0
    dry_run=0
    finish_state=
    while (( $# )); do
      case "$1" in
        --json) json=1 ;;
        --dry-run) dry_run=1 ;;
        --state)
          shift
          finish_state=${1:-}
          [[ -n "$finish_state" ]] || mep_usage
          ;;
        *) mep_usage ;;
      esac
      shift
    done
    (( json )) || mep_usage
    case "$mark_kind" in
      mise)
        [[ -z "$finish_state" ]] || mep_usage
        mep_dispatch_json mep_mark_mise_json "$mark_path" "$dry_run"
        ;;
      finish)
        [[ -n "$finish_state" ]] || mep_usage
        mep_dispatch_json mep_mark_finish_json "$mark_path" "$finish_state" "$dry_run"
        ;;
      *)
        mep_usage
        ;;
    esac
    ;;
  checkpoint)
    slug=${2:-}
    [[ -n "$slug" ]] || mep_usage
    shift 2
    json=0
    fix=0
    while (( $# )); do
      case "$1" in
        --json) json=1 ;;
        --fix) fix=1 ;;
        *) mep_usage ;;
      esac
      shift
    done
    (( json )) || mep_usage
    mep_dispatch_json mep_checkpoint_json "$slug" "$fix"
    ;;
  lifecycle)
    [[ "${2:-}" == "status" ]] || mep_usage
    slug=${3:-}
    [[ -n "$slug" ]] || mep_usage
    shift 3
    mode=
    json=0
    while (( $# )); do
      case "$1" in
        --mode)
          shift
          mode=${1:-}
          [[ -n "$mode" ]] || mep_usage
          ;;
        --json) json=1 ;;
        *) mep_usage ;;
      esac
      shift
    done
    [[ -n "$mode" ]] || mep_usage
    (( json )) || mep_usage
    mep_lifecycle_validate_mode "$mode" || mep_usage
    mep_dispatch_json mep_lifecycle_status_json "$slug" "$mode"
    ;;
  curate)
    slug=${2:-}
    [[ -n "$slug" ]] || mep_usage
    shift 2
    json=0
    mode=preview
    confirm=0
    dry_run=0
    force=0
    while (( $# )); do
      case "$1" in
        --json) json=1 ;;
        --preview) mode=preview ;;
        --measure) mode=measure ;;
        --validate) mode=validate ;;
        --execute) mode=execute ;;
        --template) mode=template ;;
        --confirm) confirm=1 ;;
        --dry-run) dry_run=1 ;;
        --force) force=1 ;;
        *) mep_usage ;;
      esac
      shift
    done
    (( json )) || mep_usage
    case "$mode" in
      preview)
        mep_dispatch_json mep_curate_json "$slug" preview
        ;;
      measure)
        mep_dispatch_json mep_curate_json "$slug" measure
        ;;
      validate)
        mep_dispatch_json mep_curate_json "$slug" validate
        ;;
      template)
        extra=()
        (( force )) && extra+=(--force)
        mep_dispatch_json mep_curate_json "$slug" template "${extra[@]}"
        ;;
      execute)
        extra=()
        (( dry_run )) && extra+=(--dry-run)
        (( confirm )) && extra+=(--confirm)
        mep_dispatch_json mep_curate_json "$slug" execute "${extra[@]}"
        ;;
      *)
        mep_usage
        ;;
    esac
    ;;
  *)
    mep_usage
    ;;
esac
